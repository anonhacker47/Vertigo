# Everything here is optional.

# Port Vertigo is served on
VERTIGO_PORT=6166

# Folder holding the database and covers
VERTIGO_DATA=./data

# Owner of the files written to VERTIGO_DATA (see `id -u` and `id -g`)
PUID=1000
PGID=1000

# Set to 1 when a reverse proxy (Traefik, Caddy, nginx) sits in front
BEHIND_PROXY=

# Set to 1 for a read-only public demo
DEMO_MODE=
